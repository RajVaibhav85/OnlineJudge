FROM node:20-slim

# Install only Docker CLI — we use the HOST daemon via socket mount
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

# Ensure the temp jobs directory exists inside container
RUN mkdir -p /usr/src/app/codes

EXPOSE 5000

CMD ["node", "server.js"]